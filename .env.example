# Bu dosya şablondur: `cp .env.example .env` ve değerleri doldurun.
# Gerçek değerler ASLA depoya girmez — `.gitignore` yalnızca bu örneği izler.
#
# Vercel'e dağıtırken: aşağıdaki "Vercel'de gerekli" bölümündekiler proje
# ayarlarına (Settings → Environment Variables) girilir. "Yalnızca yerel"
# bölümündekiler geliştirme makinesinde kalır.

# ---------------------------------------------------------------------------
# Vercel'de gerekli
# ---------------------------------------------------------------------------

# Supabase projesi → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# RLS'i BAYPAS EDER. Yalnızca sunucuda kullanılır.
# NEXT_PUBLIC_ ön eki ASLA eklenmez — o ön ek değişkeni tarayıcıya gönderir.
SUPABASE_SERVICE_ROLE_KEY=

# Sitenin kökü: kurumun müşterisine verdiği randevu bağlantısı, karekodun
# içine gömülen adres, hatırlatma mesajındaki bağlantı, sitemap ve paylaşım
# kartı hep buradan üretilir (src/lib/marketing/site-url.ts).
# Yanlış değerle basılmış karekod geri alınamaz — bkz. docs/CANLIYA-GECIS.md B16.
#
# VERCEL'DE GEREKLİ DEĞİL: boş bırakılırsa Vercel'in kendi üretim adresi
# (NEXT_PUBLIC_VERCEL_PROJECT_PRODUCTION_URL) kullanılır ve özel alan adı
# bağlandığında kendiliğinden ona döner. Buraya yalnızca başka bir yerde
# barındırıyorsan ya da adresi zorlamak istiyorsan değer yaz.
# Vercel'de localhost yazarsan yok sayılır — yerel dosyayı kopyalamak
# üretimdeki bütün bağlantıları localhost'a çeviriyordu.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Bildirim kuyruğunu boşaltan uç noktanın sırrı (/api/bildirim/gonder).
# Vercel Cron bu değeri `Authorization: Bearer …` başlığıyla gönderir
# (zamanlama vercel.json içinde; Hobby planı günde bire zorluyor).
# TANIMSIZSA kuyruk işleyicisi kapalıdır — korumasız açılmaz.
CRON_SECRET=

# ---------------------------------------------------------------------------
# Herkese açık demo — isteğe bağlı
# ---------------------------------------------------------------------------
# Siteden "demoyu dene" ile girilen vitrin kurumunun hesabı.
# `npm run demo:seed -- --vitrin` ile kurulur.
# DEMO_KAPALI=1 demoyu kapatır: sayfa "kapalı" der, düğme çizilmez.
DEMO_PUBLIC_EPOSTA=
DEMO_PUBLIC_PAROLA=
DEMO_KAPALI=

# ---------------------------------------------------------------------------
# Yalnızca yerel — Vercel'e GİRİLMEZ
# ---------------------------------------------------------------------------

# Geliştirme makinesindeki demo hesabı (`npm run demo:seed`).
# Varsayılanı YOK: boşsa komut çalışmaz. Parolayı koda yazmıyoruz.
DEMO_EMAIL=
DEMO_PAROLA=

# Şema araçları (`npm run db:push`, `db:seed`, `db:types`) kullanır.
# Üretim sunucusunun veritabanına doğrudan bağlanmasına gerek yok.

# Settings → Database → Connection string (Session pooler).
# Paroladaki özel karakterler yüzde-kodlanmalı (`#` → `%23`).
SUPABASE_DB_URL=

# Settings → General → Reference ID
SUPABASE_PROJECT_REF=

# Supabase hesabınızın CLI erişim jetonu (`npm run db:types` için).
SUPABASE_ACCESS_TOKEN=
